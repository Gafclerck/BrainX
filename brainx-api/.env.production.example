# ==============================================================================
# BrainX API - Production Environment Variables Example
# ==============================================================================

# Core Django Settings
SECRET_KEY=change-me-to-a-secure-random-64-character-string
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1,api

# Public Browsing Toggle (Epic 1 / AD-AuthToggle)
BRAINX_PUBLIC_BROWSING=True

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://brainx:brainx_secure_production_password@db:5432/brainx

# Redis / Channel Layer Cache
REDIS_URL=redis://redis:6379/0

# Universal S3-Compatible Object Storage (Backblaze B2, Cloudflare R2, MinIO, or AWS S3)
STORAGE_BACKEND=s3
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_NAME=brainx-production-attachments
S3_REGION_NAME=eu-central-003
# Endpoint URL defines the provider (Interface inversion):
# - Backblaze B2 example: https://s3.eu-central-003.backblazeb2.com
# - Cloudflare R2 example: https://<account-id>.r2.cloudflarestorage.com
# - AWS S3 example: leave empty or https://s3.eu-west-3.amazonaws.com
S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com

# Email Backend (SMTP or Provider Delivery Backend)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-or-ses-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# Frontend and CORS Integration (Vercel Edge SPA)
FRONTEND_URL=https://brainx.vercel.app
CORS_ALLOWED_ORIGINS=https://brainx.vercel.app
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://brainx.vercel.app

# Reverse Proxy Domain for Caddy
DOMAIN=api.yourdomain.com
